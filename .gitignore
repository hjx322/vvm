# ============================================================================
#  .gitignore —— VVM 数智医生智能体
#
#  作用：告诉 git「哪些文件不要上传」。被这里命中的文件，在你本机照常存在、程序
#        照常能跑，只是执行 git add / git push 时会被自动跳过，不会出现在 GitHub 上。
#
#  规则分六类：
#    ① 密钥与本地配置      ② 患者隐私数据(PHI)   ③ 运行产物 / 日志 / 上传
#    ④ 模型权重与大文件    ⑤ 第三方依赖与构建目录 ⑥ 编辑器与系统杂项
#
#  ⚠️ 重要：.gitignore 只对「还没有被提交过」的文件生效。
#     如果你已经 git add 过某个敏感文件，光加规则是没用的，必须执行：
#         git rm --cached <文件>      # 从 git 索引里删掉，但保留本地文件
#     详见 README.md 的「安全与隐私」章节。
# ============================================================================


# ---------------------------------------------------------------------------
# ① 密钥与本地配置 —— 真实凭据，泄露即等于把数据库/接口交给别人
# ---------------------------------------------------------------------------

# 真实密钥文件（模板 .env.example 不屏蔽）
.env
.env.*
!.env.example

# 真实运行配置（只提交 application.example.yaml 模板）
application.yaml
application.local.yaml
application-*.yaml

# 其它常见的本地凭据文件
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json


# ---------------------------------------------------------------------------
# ② 患者隐私数据（PHI）—— 泄露会直接违反《个人信息保护法》/ 医疗数据合规要求
#    这些是本项目最敏感的部分，务必全部屏蔽
# ---------------------------------------------------------------------------

# 真实医患对话（1179 份 xlsx，文件名即患者微信昵称，内容含病情+手机号）
data/dialogs/

# 真实对话切片（评测/调试用，同样是真实患者内容）
data/test_dialog/

# 评测集：含真实患者姓名与自述病情（保留脱敏模板 eval.example.jsonl）
data/eval.jsonl
data/eval*.jsonl
!data/eval.example.jsonl

# 由真实对话生成 / 用于建向量库的语料（9.3MB）
data/qa_vector_data.xlsx

# 真实问诊录音
data/*.amr
data/*.wav
data/*.mp3

# 全量业务数据表（药品库 22MB；保留 药品库_sample.xlsx 供他人了解表结构）
data/*.xlsx
!data/药品库_sample.xlsx

# 兜底：data 目录下任何新增的数据文件都不会被误提交
#（如果确实要开源某个数据集，用下面的写法单独放行）
#   !data/your-public-dataset.csv
data/**/*.csv

# 技能运行时产生的患者相关输出
user_skills/
uploads/

# 皮肤检测的运行结果图（含真实患处照片）
derma_image/
.claude/skills/derma_image/runs/
.claude/skills/derma_image/references/runs/


# ---------------------------------------------------------------------------
# ③ 运行产物 / 日志 / 缓存
# ---------------------------------------------------------------------------

logs/
*.log

__pycache__/
*.py[cod]
*$py.class
*.so

# CLI 历史记录（会记录你输入过的对话内容）
.cli_history
.python_history


# ---------------------------------------------------------------------------
# ④ 模型权重与大文件 —— 体积大，且 GitHub 单文件上限 100MB
# ---------------------------------------------------------------------------

*.pt
*.pth
*.onnx
*.h5
*.ckpt
*.safetensors
*.zip
*.tar.gz
*.7z


# ---------------------------------------------------------------------------
# ⑤ 第三方依赖与构建产物 —— 可随时用 npm install / uv sync 重新生成
# ---------------------------------------------------------------------------

.venv/
venv/
env/
.conda/

node_modules/
frontend/node_modules/

# 前端打包产物
frontend/dist/
dist/
dist-ssr/
build/

# 包管理器缓存
.npm/
.pnpm-store/
.yarn/


# ---------------------------------------------------------------------------
# ⑥ 编辑器与系统杂项
# ---------------------------------------------------------------------------

.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

.DS_Store
Thumbs.db
desktop.ini

# 误用 %USERPROFILE% 未展开而生成的空目录（Windows 下的常见事故）
%USERPROFILE%/

# Claude Code 的本机设置（含个人权限配置，因人而异，不该提交）
.claude/settings.local.json

# 与本项目无关的个人工具配置
babel.json
*.code-workspace
