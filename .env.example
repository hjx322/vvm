# ============================================================================
#  .env.example —— 密钥模板（可以提交到 GitHub）
#
#  使用方法：复制本文件为 .env，填入你自己的真实值。.env 已被 .gitignore 忽略。
#      PowerShell:  Copy-Item .env.example .env
#      bash:        cp .env.example .env
#
#  语法：KEY=VALUE，一行一个；# 开头是注释；值两端可以用引号包起来。
#        等号两边不要留空格；值里如果本身含 # 或空格，请用引号包住。
# ============================================================================

# --- 大模型：阿里云百炼 DashScope -------------------------------------------
# 申请地址 https://bailian.console.aliyun.com/ → API-KEY 管理
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# --- 业务库 MySQL（存 agent / skill 配置）----------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DB=vvm_digital_smart_doctor_agent

# --- 患者库 MySQL（存病历等 PHI，敏感度最高）-------------------------------
PATIENT_MYSQL_HOST=127.0.0.1
PATIENT_MYSQL_PORT=3306
PATIENT_MYSQL_USER=root
PATIENT_MYSQL_PASSWORD=your-patient-db-password
PATIENT_MYSQL_DB=vvm_hn_skin_crm

# --- Milvus 向量库 ----------------------------------------------------------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=your-milvus-password
MILVUS_DB=digital_smart_doctor_agent

# --- 腾讯云语音识别（ASR）---------------------------------------------------
# 控制台 https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key

# --- Tavily 联网搜索 --------------------------------------------------------
# https://app.tavily.com/home → API Keys
TAVILY_API_KEY=tvly-dev-your-tavily-key

# --- 业务参数 ---------------------------------------------------------------
MANAGEMENT_USER_ID=1827196
